{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "level_item_qc_lane_output",
  "type": "object",
  "additionalProperties": false,
  "required": ["lane_id", "item_id", "result", "confidence", "evidence", "unresolved"],
  "properties": {
    "lane_id": { "type": "string" },
    "item_id": {
      "type": "string",
      "description": "Stable level key, e.g. level:2"
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "verdict",
        "counts",
        "quality",
        "defects",
        "hard_fail"
      ],
      "properties": {
        "level": { "type": "integer", "minimum": 1, "maximum": 6 },
        "verdict": { "type": "string", "enum": ["pass", "warn", "fail"] },
        "counts": {
          "type": "object",
          "additionalProperties": { "type": "number" }
        },
        "quality": {
          "type": "object",
          "additionalProperties": { "type": "number" }
        },
        "defects": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "severity", "path", "message"],
            "properties": {
              "code": { "type": "string" },
              "severity": {
                "type": "string",
                "enum": ["error", "warning", "info"]
              },
              "path": { "type": "string" },
              "message": { "type": "string" }
            }
          }
        },
        "hard_fail": { "type": "boolean" }
      }
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "evidence": { "type": "array", "items": { "type": "string" } },
    "unresolved": { "type": "array", "items": { "type": "string" } }
  }
}
