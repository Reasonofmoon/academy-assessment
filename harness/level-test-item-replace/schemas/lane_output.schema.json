{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "level_test_lane_output",
  "type": "object",
  "additionalProperties": false,
  "required": ["lane_id", "item_id", "result", "confidence", "evidence", "unresolved"],
  "properties": {
    "lane_id": { "type": "string" },
    "item_id": { "type": "string" },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["disposition_vote", "codes", "severity", "notes", "span"],
      "properties": {
        "disposition_vote": {
          "type": "string",
          "enum": ["keep", "repair", "replace", "quarantine"]
        },
        "codes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "severity": {
          "type": "string",
          "enum": ["pass", "warning", "error"]
        },
        "notes": { "type": "string" },
        "span": {
          "type": "string",
          "description": "Field or span this judgment applies to (question|options|irt|passage|item)"
        }
      }
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "evidence": {
      "type": "array",
      "items": { "type": "string" }
    },
    "unresolved": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
