{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "level_test_smoke_lane_output",
  "type": "object",
  "additionalProperties": false,
  "required": ["lane_id", "item_id", "result", "confidence", "evidence", "unresolved"],
  "properties": {
    "lane_id": { "type": "string" },
    "item_id": { "type": "string" },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "attempts",
        "correct",
        "total",
        "accuracy",
        "item_results",
        "verdict"
      ],
      "properties": {
        "level": { "type": "integer" },
        "attempts": { "type": "integer" },
        "correct": { "type": "integer" },
        "total": { "type": "integer" },
        "accuracy": { "type": "number" },
        "item_results": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "item_id",
              "domain",
              "chosen",
              "gold",
              "is_correct",
              "solver_note"
            ],
            "properties": {
              "item_id": { "type": "string" },
              "domain": { "type": "string" },
              "chosen": { "type": "string" },
              "gold": { "type": "string" },
              "is_correct": { "type": "boolean" },
              "solver_note": { "type": "string" },
              "flags": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        },
        "verdict": {
          "type": "string",
          "enum": ["pass", "warn", "fail"]
        }
      }
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "evidence": { "type": "array", "items": { "type": "string" } },
    "unresolved": { "type": "array", "items": { "type": "string" } }
  }
}
